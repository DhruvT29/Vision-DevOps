// Vision engine database — local SQLite.
// JSON-shaped data is stored as stringified JSON in *Json columns
// (SQLite provider has no native Json type).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Analysis side (rebuilt per scan) ────────────────────────────────────────

model Project {
  id                 String        @id @default(cuid())
  name               String
  rootPath           String        @unique
  detectedStacksJson String        @default("[]")
  source             String        @default("local") // local | github
  repoUrl            String? // canonical https URL — display + blob links
  repoCloneUrl       String? // transport URL git used (ssh or https)
  repoBranch         String?
  createdAt          DateTime      @default(now())
  lastOpenedAt       DateTime      @default(now())
  snapshots          Snapshot[]
  environments       Environment[]
  executions         Execution[]
  collections        Collection[]
  scenarios          Scenario[]
  deployTargets      DeployTarget[]
}

model Snapshot {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        String         @default("pending") // pending | running | completed | failed
  error         String?
  statsJson     String?
  createdAt     DateTime       @default(now())
  modules       ModuleNode[]
  frontendCalls FrontendCall[]
  edges         GraphEdge[]
  entities      EntityNode[]

  @@index([projectId])
}

// Database entity (TypeORM @Entity class) — the schema layer under modules
model EntityNode {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  name        String // class name, e.g. "User"
  tableName   String // resolved table name, e.g. "users"
  filePath    String
  line        Int      @default(1)
  moduleId    String? // owning ModuleNode row id
  columnsJson String   @default("[]")

  @@index([snapshotId])
}

model ModuleNode {
  id         String     @id @default(cuid())
  snapshotId String
  snapshot   Snapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  name       String
  kind       String // nest-module | next-api-group | react-feature
  filePath   String
  isGlobal   Boolean    @default(false) // Nest @Global() — providers reachable without imports
  endpoints  Endpoint[]

  @@index([snapshotId])
}

model Endpoint {
  id             String     @id @default(cuid())
  moduleId       String
  module         ModuleNode @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  layer          String // nest | next-api
  method         String
  fullPath       String
  handlerName    String
  paramsJson     String     @default("[]")
  bodyFieldsJson String?
  bodyTypeName   String?
  authJson       String     @default("{\"required\":false,\"guards\":[],\"roles\":[]}")
  filePath       String
  line           Int

  @@index([moduleId])
}

model FrontendCall {
  id           String   @id @default(cuid())
  snapshotId   String
  snapshot     Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  client       String // axios | fetch | react-query | rtk-query | other
  method       String
  rawUrl       String
  resolvedPath String?
  callerSymbol String
  filePath     String
  line         Int

  @@index([snapshotId])
}

// ── Testing side (persistent, user-owned) ───────────────────────────────────

model Environment {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  baseUrl       String
  variablesJson String   @default("{}")
  authJson      String   @default("{\"type\":\"none\"}")
  createdAt     DateTime @default(now())

  @@index([projectId])
}

model Execution {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpointId          String? // loose ref — endpoints are per-snapshot rows
  environmentId       String?
  method              String
  url                 String
  requestHeadersJson  String   @default("{}")
  requestBody         String?
  status              Int?
  durationMs          Int
  responseHeadersJson String   @default("{}")
  responseBody        String?
  truncated           Boolean  @default(false)
  error               String?
  createdAt           DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([endpointId])
}

model Collection {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String? // nested collections act as folders
  name      String
  createdAt DateTime       @default(now())
  requests  SavedRequest[]

  @@index([projectId])
}

model SavedRequest {
  id           String         @id @default(cuid())
  collectionId String
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  endpointId   String? // loose ref to the snapshot endpoint it came from
  method       String
  url          String // path or absolute, may contain {{vars}}
  headersJson  String         @default("{}")
  body         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assertions   Assertion[]
  steps        ScenarioStep[]

  @@index([collectionId])
}

model Assertion {
  id             String       @id @default(cuid())
  savedRequestId String
  savedRequest   SavedRequest @relation(fields: [savedRequestId], references: [id], onDelete: Cascade)
  type           String // status | jsonPath | header | responseTime
  pathExpr       String? // dot path for jsonPath, header name for header
  operator       String // eq | neq | lt | gt | contains | exists
  expected       String?

  @@index([savedRequestId])
}

model Scenario {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  steps     ScenarioStep[]

  @@index([projectId])
}

model ScenarioStep {
  id              String       @id @default(cuid())
  scenarioId      String
  scenario        Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  savedRequestId  String
  savedRequest    SavedRequest @relation(fields: [savedRequestId], references: [id], onDelete: Cascade)
  order           Int
  extractionsJson String       @default("[]") // [{ name, pathExpr }] response → runtime vars

  @@index([scenarioId])
}

// ── Deployment side (persistent, user-owned) ────────────────────────────────

// A remote box reachable over SSH. Reusable across projects. The PEM key (and
// optional passphrase) is sealed with AES-256-GCM (see deploy/secret-box.ts) —
// it is NEVER serialized to the API or logged.
model Server {
  id                String         @id @default(cuid())
  name              String
  host              String
  port              Int            @default(22)
  username          String
  encryptedAuthJson String // sealed { privateKey, passphrase? }
  createdAt         DateTime       @default(now())
  targets           DeployTarget[]
}

// A named deploy destination for a project (e.g. "staging", "production"):
// server + remote working dir + pipeline config.
model DeployTarget {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serverId      String
  server        Server       @relation(fields: [serverId], references: [id], onDelete: Restrict)
  name          String
  workingDir    String // remote dir steps run in
  preflightJson String       @default("[]") // remote commands that must exit 0 BEFORE upload/steps
  uploadJson    String? // { localDir, excludeDirs[], excludeFiles[], remoteZipPath } — null = no upload phase
  branch        String? // when set, package zips this branch fetched from the git remote, not localDir
  stepsJson     String       @default("[]") // [{ name?, command, confirmBefore?, confirmOnFailure?, enabled? }]
  localPreJson  String       @default("[]") // local commands run on THIS machine before packaging
  localPostJson String       @default("[]") // local commands run on THIS machine after the health check
  scriptPath    String? // deploy script this target was imported from (for re-sync)
  healthUrl     String?
  dbConfigJson  String? // sealed DB connection override (see dbschema/) — null = auto-discover from .env
  createdAt     DateTime     @default(now())
  deployments   Deployment[]
  dbSchemaCache DbSchemaCache?

  @@index([projectId])
}

// Cached result of the last live DB introspection for a target. Schema names
// are not secret, so this is stored plaintext (the connection is not).
model DbSchemaCache {
  id         String       @id @default(cuid())
  targetId   String       @unique
  target     DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  engine     String
  database   String
  schemaJson String
  fetchedAt  DateTime     @default(now())
}

model Deployment {
  id         String       @id @default(cuid())
  targetId   String
  target     DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  projectId  String // denormalized for per-project history queries
  status     String       @default("running") // running | succeeded | failed | cancelled
  stepsJson  String       @default("[]") // [{ phase, name, command?, status, exitCode?, durationMs? }]
  log        String       @default("") // combined output, capped at 2 MB
  truncated  Boolean      @default(false)
  error      String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([targetId, startedAt])
  @@index([projectId, startedAt])
}

model GraphEdge {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  sourceId   String
  targetId   String
  type       String // contains | calls | imports | file-imports
  confidence Float    @default(1)
  manual     Boolean  @default(false)
  metaJson   String? // edge-type-specific evidence, e.g. file-imports: { count, files }

  @@index([snapshotId])
}
